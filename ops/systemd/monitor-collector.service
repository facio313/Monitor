[Unit]
Description=Host telemetry collector for Monitor
Documentation=file:/usr/local/share/doc/monitor-collector/README.md
Wants=monitor-container-exporter.service
After=local-fs.target monitor-container-exporter.service

[Service]
Type=oneshot
User=root
Group=cks
EnvironmentFile=-/etc/default/monitor-collector
ExecStart=/usr/bin/python3 /usr/local/lib/monitor-collector/collector.py --docker-sockets= --container-input=/run/monitor-container-exporter/containers.json --process-uids=0,1001 --traffic-log=/var/log/nginx/monitor-traffic.jsonl --mountinfo=/proc/1/mountinfo
RuntimeDirectory=monitor-collector
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=monitor-export
StateDirectoryMode=0750
UMask=0027

# The collector needs aggregate proc/sys telemetry, selected logs (including
# the configured kernel and privacy-preserving traffic logs), and the reduced
# cks-owned container snapshot. The Docker socket is outside this namespace.
# PID 1's mountinfo is the host mount namespace; self/mountinfo would instead
# report the read-only view intentionally created by ProtectSystem below.
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home /root
TemporaryFileSystem=/run:ro
BindPaths=/run/monitor-collector
BindReadOnlyPaths=-/run/monitor-container-exporter/containers.json
BindReadOnlyPaths=-/var/lib/monitor-synthetic/results.json
# Read-only observation surfaces only; the systemd control sockets remain
# outside this service's private /run namespace.
BindReadOnlyPaths=-/run/systemd/units -/run/systemd/timesync
PrivateTmp=true
PrivateDevices=true
BindPaths=-/dev/vcio
DeviceAllow=/dev/vcio rw
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryHigh=160M
MemoryMax=192M
TasksMax=64
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
ReadOnlyPaths=/proc /sys /var/log
ReadWritePaths=/var/lib/monitor-export /run/monitor-collector

TimeoutStartSec=45s
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
