[Unit]
Description=Read-only host telemetry collector for Monitor
Documentation=file:/usr/local/share/doc/monitor-collector/README.md
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=cks
EnvironmentFile=-/etc/default/monitor-collector
ExecStart=/usr/bin/python3 /usr/local/lib/monitor-collector/collector.py
RuntimeDirectory=monitor-collector
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=monitor-export
StateDirectoryMode=0750
UMask=0027

# The collector needs aggregate proc/sys telemetry, selected logs (including
# the configured kernel log), and the three read-only rootless Docker API
# sockets. It writes only its state/export roots.
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/home /root
PrivateTmp=true
PrivateDevices=true
BindPaths=-/dev/vcio
DeviceAllow=/dev/vcio rw
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryHigh=160M
MemoryMax=192M
TasksMax=64
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
ReadOnlyPaths=/proc /sys /var/log /run/user
ReadWritePaths=/var/lib/monitor-export /run/monitor-collector

TimeoutStartSec=45s
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
