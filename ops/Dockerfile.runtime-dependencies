# Preserve the deployed application while updating only locked runtime packages.
# MONITOR_BASE_IMAGE must identify the reviewed, currently deployed image.
ARG MONITOR_BASE_IMAGE
FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm audit --omit=dev --audit-level=critical

FROM ${MONITOR_BASE_IMAGE}
RUN rm -rf /app/node_modules
COPY --from=dependencies /app/node_modules /app/node_modules
