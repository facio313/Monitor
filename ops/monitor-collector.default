# Optional environment overrides for monitor-collector.service.
# Paths make the collector testable with fixture proc/sys/log trees.
MONITOR_OUTPUT_DIR=/var/lib/monitor-export
MONITOR_RUNTIME_DIR=/run/monitor-collector
MONITOR_PROC_ROOT=/proc
MONITOR_SYS_ROOT=/sys
MONITOR_ETC_ROOT=/etc
MONITOR_PACKAGE_ROOT=/
MONITOR_EVENTS_LOG=/var/log/server-watch/events.log
MONITOR_KERNEL_LOG=/var/log/kern.log
MONITOR_PRIVILEGE_LOGS=/var/log/privilege-events.log
MONITOR_TRAFFIC_LOG=/var/log/nginx/monitor-traffic.jsonl
# Production consumes only the unprivileged fixed-schema snapshot.
MONITOR_DOCKER_SOCKETS=
MONITOR_CONTAINER_INPUT=/run/monitor-container-exporter/containers.json
# Optional SSRF-safe unprivileged worker handoff. A missing result remains
# explicitly unsupported and never blocks host collection.
MONITOR_SYNTHETIC_INPUT=/var/lib/monitor-synthetic/results.json
MONITOR_PROCESS_UIDS=0,1001
# Exact process comm names and system service units explicitly approved for
# detailed status. Process argv and environment are never collected.
MONITOR_PROCESS_ALLOWLIST=
MONITOR_SYSTEMD_UNITS=monitor-collector.service,monitor-container-exporter.service,containerd.service,nginx.service,ssh.service,systemd-timesyncd.service
MONITOR_SSH_PORTS=22,22022
MONITOR_PRIMARY_INTERFACE=eth0
MONITOR_CURL=/usr/bin/curl
MONITOR_VCGENCMD=/usr/bin/vcgencmd
MONITOR_SYSTEMCTL=/usr/bin/systemctl
MONITOR_TIMEDATECTL=/usr/bin/timedatectl
MONITOR_SYSTEMD_STATE_DIR=/run/systemd/units
MONITOR_DOCKER_DATA_ROOT=/var/lib/docker
MONITOR_COMMAND_TIMEOUT=2
MONITOR_EXPECTED_INTERVAL_SECONDS=60
MONITOR_AGENT_LIFECYCLE=active
MONITOR_RETENTION_DAYS=30
MONITOR_MAX_LOG_RECORDS=5000
MONITOR_INCIDENT_RETENTION_DAYS=30
MONITOR_MAX_INCIDENT_RECORDS=1000
MONITOR_INCIDENT_FOLLOW_UP_SAMPLES=5
MONITOR_CPU_WARN_PERCENT=85
MONITOR_CPU_RECOVER_PERCENT=75
MONITOR_CPU_WARN_SAMPLES=2
MONITOR_MEMORY_AVAILABLE_WARN_PERCENT=20
MONITOR_MEMORY_AVAILABLE_RECOVER_PERCENT=25
MONITOR_TEMPERATURE_WARN_C=75
MONITOR_TEMPERATURE_RECOVER_C=72
MONITOR_LOAD_WARN=4
MONITOR_LOAD_RECOVER=2
MONITOR_DISK_IO_WARN_BYTES_PER_SECOND=104857600
MONITOR_DISK_IO_RECOVER_BYTES_PER_SECOND=52428800
MONITOR_TRAFFIC_REQUEST_WARN=300
MONITOR_TRAFFIC_REQUEST_RECOVER=200
MONITOR_TRAFFIC_SLOW_SECONDS=1
MONITOR_MAX_INPUT_BYTES=1048576
MONITOR_KERNEL_MAX_INPUT_BYTES=8388608
MONITOR_RULE_PACK=/usr/local/lib/monitor-collector/rules/default-rules.v1.json
# Reviewed generic-log allowlist. Missing is an explicit no-data state unless
# MONITOR_LOG_SOURCES_REQUIRED is true; unsafe configs fail closed.
MONITOR_LOG_SOURCES_CONFIG=/etc/monitor-collector/log-sources.json
MONITOR_LOG_SOURCES_REQUIRED=false
MONITOR_JOURNALCTL=/usr/bin/journalctl
MONITOR_GENERIC_LOG_RETENTION_DAYS=30
MONITOR_GENERIC_LOG_MAX_RECORDS=20000
MONITOR_GENERIC_LOG_MAX_FILE_BYTES=16777216
# One collection cycle spends at most this many seconds across journald sources.
MONITOR_GENERIC_LOG_TOTAL_TIMEOUT=15

# Fixture-only overrides (normally leave unset):
# MONITOR_MOUNTINFO=/path/to/fixture/mountinfo
# MONITOR_MOUNT_ROOT=/path/to/fixture/root
